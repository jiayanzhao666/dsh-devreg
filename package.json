{
  "name": "dsh-devreg",
  "version": "0.1.0",
  "description": "A local development service registry with a DeepSeek Harness plugin.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "devreg": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --import tsx/esm tests/*.test.ts",
    "devreg": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.2",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
